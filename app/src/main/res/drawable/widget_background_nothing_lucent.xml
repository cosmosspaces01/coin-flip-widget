<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background for Nothing Lucent coin: translucent dark card with rounded corners and white highlight stroke -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <solid android:color="@color/nothing_lucent_bg" />
    <stroke
        android:width="1.5dp"
        android:color="@color/nothing_lucent_stroke" />
</shape>

