<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background for Nothing Dial: circular Lucent container with 12 dial dots and 12h red accent indicator -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Circular base fill (Lucent dark slate 20% alpha) -->
    <path
        android:fillColor="#331B1B1D"
        android:pathData="M100,100m-98,0a98,98,0,1,1,196,0a98,98,0,1,1,-196,0" />

    <!-- Circular perimeter outline (15% white) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#26FFFFFF"
        android:strokeWidth="1.5"
        android:pathData="M100,100m-98,0a98,98,0,1,1,196,0a98,98,0,1,1,-196,0" />

    <!-- Concentric hairline dashed track ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1FFFFFFF"
        android:strokeWidth="1"
        android:pathData="M100,100m-92,0a92,92,0,1,1,184,0a92,92,0,1,1,-184,0" />

    <!-- 12-o'clock Nothing red indicator pill -->
    <path
        android:fillColor="#E51919"
        android:pathData="M97,4h6v6h-6z" />

    <!-- 12 Dial Dots around perimeter -->
    <!-- 6 o'clock -->
