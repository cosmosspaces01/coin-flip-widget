<?xml version="1.0" encoding="utf-8"?>
<!-- Main Activity Layout -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Coin Flip"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/gold_400"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/instructionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tap_coin_instruction"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:visibility="visible" />

        <!-- Coin Container with Dynamic Background Preview -->
        <FrameLayout
            android:id="@+id/coinContainerMain"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="32dp">

            <ImageView
                android:id="@+id/coinBackgroundMain"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY" />

            <ImageView
                android:id="@+id/coinImageMain"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:padding="16dp"
                android:src="@drawable/coin_heads"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/coin_description" />
        </FrameLayout>

        <!-- Result -->
        <TextView
            android:id="@+id/resultTextMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/tap_to_flip"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif-medium" />

        <!-- Streak -->
        <TextView
            android:id="@+id/streakTextMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:textColor="@color/gold_300"
            android:visibility="gone" />

        <!-- Stats Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Heads Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/stat_card_background"
                android:padding="16dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:id="@+id/headsCountMain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Heads: 0"
                    android:textSize="16sp"
                    android:textColor="@color/gold_400"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tails Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/stat_card_background"
                android:padding="16dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:id="@+id/tailsCountMain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tails: 0"
                    android:textSize="16sp"
                    android:textColor="@color/blue_glow"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Total -->
        <TextView
            android:id="@+id/totalCountMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Total: 0"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/flipButtonMain"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="2"
                android:layout_marginEnd="6dp"
                android:text="Flip Coin"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1a0f00"
                android:backgroundTint="@color/gold_500"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/resetButtonMain"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Reset"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:backgroundTint="@color/bg_card"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- 1. Coin Design Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/coin_style_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif-medium" />

        <RadioGroup
            android:id="@+id/coinStyleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <RadioButton
                android:id="@+id/radioDefaultCoin"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/coin_style_default"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/gold_400"
                android:background="@drawable/stat_card_background"
                android:gravity="center"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioNothingCoin"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:text="@string/coin_style_nothing"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/dark_grey"
                android:background="@drawable/stat_card_background"
                android:gravity="center" />

            <RadioButton
                android:id="@+id/radioNothingGlassCoin"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/coin_style_nothing_glass"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/blue_glow"
                android:background="@drawable/stat_card_background"
                android:gravity="center" />

        </RadioGroup>

        <!-- 2. Widget Frame Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/widget_frame_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif-medium" />

        <RadioGroup
            android:id="@+id/widgetFrameGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <RadioButton
                android:id="@+id/radioFrameSolid"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/widget_frame_solid"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/dark_grey"
                android:background="@drawable/stat_card_background"
                android:gravity="center" />

            <RadioButton
                android:id="@+id/radioFrameLucent"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:text="@string/widget_frame_lucent"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/text_secondary"
                android:background="@drawable/stat_card_background"
                android:gravity="center"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioFrameDial"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/widget_frame_dial"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/rose_glow"
                android:background="@drawable/stat_card_background"
                android:gravity="center" />

        </RadioGroup>

        <!-- 3. Background Opacity Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bg_opacity_label"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/opacityValueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20%"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/gold_400"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/opacitySeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:min="10"
            android:max="95"
            android:progress="20"
            android:thumbTint="@color/gold_400"
            android:progressTint="@color/gold_400" />

        <!-- 4. Background Tint Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/bg_tint_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif-medium" />

        <RadioGroup
            android:id="@+id/bgTintGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <RadioButton
                android:id="@+id/radioTintSlate"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="@string/tint_slate"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/dark_grey"
                android:background="@drawable/stat_card_background"
                android:gravity="center"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioTintOled"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:text="@string/tint_oled"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:buttonTint="#555555"
                android:background="@drawable/stat_card_background"
                android:gravity="center" />

            <RadioButton
                android:id="@+id/radioTintRed"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:text="@string/tint_red"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/rose_glow"
                android:background="@drawable/stat_card_background"
                android:gravity="center" />

            <RadioButton
                android:id="@+id/radioTintFrost"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:text="@string/tint_frost"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:buttonTint="#E0E0E0"
                android:background="@drawable/stat_card_background"
                android:gravity="center" />

        </RadioGroup>

        <!-- Spacer -->
        <View
            android:layout_width="1dp"
            android:layout_height="32dp" />

    </LinearLayout>
</ScrollView>
